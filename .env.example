# 复制为 .env 后填写；.env 已被忽略，不要上传或提交真实 Token。
TUSHARE_TOKEN=
TUSHARE_API_URL=http://api.tushare.pro/dataapi

# DeepSeek 仅用于每日市场总结和数据问答；新闻直接使用原标题。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120

# 仪表盘必须配置密码和随机会话密钥；HTTPS 部署时 COOKIE_SECURE 改为 1。
SG_QUANT_DASHBOARD_PASSWORD=
SG_QUANT_SESSION_SECRET=
SG_QUANT_CHAT_RATE_LIMIT=30
SG_QUANT_LOGIN_RATE_LIMIT=10
SG_QUANT_COOKIE_SECURE=0
# 问答联网检索：auto 优先 Tavily，失败或结果不足时补 Google/Bing RSS。
TAVILY_API_KEY=
SG_QUANT_WEB_SEARCH_PROVIDER=auto
SG_QUANT_WEB_SEARCH_TIMEOUT=8
SG_QUANT_WEB_SEARCH_CACHE_SECONDS=600

# 本机默认只监听回环地址。局域网访问可改为 0.0.0.0。
SG_QUANT_HOST=127.0.0.1
SG_QUANT_PORT=5000
SG_QUANT_OPEN_BROWSER=1
SG_QUANT_WORKERS=1
SG_QUANT_SCAN_WORKERS=6
SG_QUANT_HTTP_TIMEOUT=15
# 15:35 起全市场流程必须取得当天行情，格式固定为 HH:MM。
SG_QUANT_DATA_READY_TIME=15:35
